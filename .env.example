# Supabase — the visitor trace (§7). PUBLISHABLE key only.
#
# This key is meant to be in the browser: it carries the `anon` role, and the
# visitor_strokes table's RLS grants that role SELECT and INSERT and nothing
# else. UPDATE and DELETE have no policy, so they are denied.
#
# NEVER put the service-role key here. NEXT_PUBLIC_ inlines the value into the
# client bundle, and service-role bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
